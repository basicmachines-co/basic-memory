# Dev mode for this checkout (needs direnv: https://direnv.net).
#
# Basic Memory reads its config and database from BASIC_MEMORY_CONFIG_DIR when
# it is set. Pointing it at a dev directory here means `bm`, the tests and the
# MCP server run from this checkout never touch your everyday
# ~/.config/basic-memory, so dev settings (a Postgres backend, for example)
# cannot leak into the release you use day to day.
#
# Run `direnv allow` once per checkout or worktree. Set
# BASIC_MEMORY_DEV_CONFIG_DIR to use a different dev directory.
export BASIC_MEMORY_CONFIG_DIR="${BASIC_MEMORY_DEV_CONFIG_DIR:-$HOME/.config/basic-memory-dev}"
